<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ subject }}</title>

<style>
  /* ===== Colors as CSS variables for light/dark support =====
     Default (no [data-theme] attr) = OS preference via media query.
     Toggle JS sets data-theme="light" or "dark" on <html> to override. */

  :root {
    --bg:          #f5f5f5;
    --fg:          #222;     /* primary body text */
    --fg-2:        #444;     /* labels, calendar times */
    --fg-3:        #666;     /* secondary, date line, subtitles */
    --fg-4:        #888;     /* faint — senders, source labels */
    --fg-5:        #999;     /* footer */
    --fg-6:        #aaa;     /* very faint — email date dot */
    --header-bg:   #222;
    --header-fg:   #fff;
    --stub-bg:     #fafafa;
    --stub-border: #ccc;
    --border:      #ddd;
    --border-strong: #222;   /* h1 underline */
    --link:        #1a4d99;
    --link-visited:#8a6fa3;
    --error:       #b00;
    --warn:        #a06000;
  }

  /* OS-preference dark, used when no explicit data-theme is set */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --bg:          #121212;
      --fg:          #E0E0E0;
      --fg-2:        #C0C0C0;
      --fg-3:        #A0A0A0;
      --fg-4:        #909090;
      --fg-5:        #808080;
      --fg-6:        #707070;
      --header-bg:   #2c2941;
      --header-fg:   #b0b0b0;
      --stub-bg:     #1f1f1f;
      --stub-border: #444444;
      --border:      #444444;
      --border-strong: #444444;
      --link:        #7b79af;
      --link-visited:#B0B0B0;
      --error:       #ff6b6b;
      --warn:        #ffb454;
    }
  }

  /* Explicit override via the toggle button (wins over media query) */
  :root[data-theme="dark"] {
    --bg:          #121212;
    --fg:          #E0E0E0;
    --fg-2:        #C0C0C0;
    --fg-3:        #A0A0A0;
    --fg-4:        #909090;
    --fg-5:        #808080;
    --fg-6:        #707070;
    --header-bg:   #2c2941;
    --header-fg:   #b0b0b0;
    --stub-bg:     #1f1f1f;
    --stub-border: #444444;
    --border:      #444444;
    --border-strong: #444444;
    --link:        #7b79af;
    --link-visited:#B0B0B0;
    --error:       #ff6b6b;
    --warn:        #ffb454;
  }
  /* data-theme="light" inherits :root defaults; no extra rule needed. */

  /* Two-column rows above and inside the news section.
     640px breakpoint = phones stack, tablets-and-up stay 2-col. */
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 640px) {
    .cols { grid-template-columns: 1fr; }
  }

  /* News links: read-state styling via :visited.
     :visited can only safely change color/bg/border/outline/text-decoration
     per browser privacy rules. Additionally, Chromium-based browsers block
     CSS variable resolution inside :visited (anti-history-sniffing), so the
     visited colors MUST be hard-coded literals here — not var() refs. */
  .news-link          { color: var(--link); text-decoration: none; }
  .news-link:visited  { color: #8a6fa3; }  /* light mode visited (muted purple) */

  /* Dark mode visited override — also must be a hard-coded literal. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .news-link:visited { color: #B0B0B0; }
  }
  :root[data-theme="dark"] .news-link:visited { color: #B0B0B0; }

  /* Theme toggle button (top-right of page header) */
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-3);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.2;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  .theme-toggle:hover { color: var(--fg); border-color: var(--fg-3); }

  /* Icon swap on the toggle: show the icon for the OTHER mode (what you'd switch to). */
  /* Default state: show moon (clicking switches to dark). */
  .theme-toggle .icon-light { display: none; }
  .theme-toggle .icon-dark  { display: inline; }
  /* If OS preference is dark and no explicit override, show sun (clicking switches to light). */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .theme-toggle .icon-dark  { display: none; }
    :root:not([data-theme]) .theme-toggle .icon-light { display: inline; }
  }
  /* Explicit overrides (toggle button has set data-theme): */
  :root[data-theme="dark"] .theme-toggle .icon-dark  { display: none; }
  :root[data-theme="dark"] .theme-toggle .icon-light { display: inline; }
  :root[data-theme="light"] .theme-toggle .icon-dark  { display: inline; }
  :root[data-theme="light"] .theme-toggle .icon-light { display: none; }
</style>

<script>
  /* Apply saved theme as early as possible to avoid a light/dark flash. */
  (function () {
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    } catch (e) { /* localStorage unavailable; fall through to OS preference */ }
  })();

  function toggleTheme() {
    var root = document.documentElement;
    var current = root.getAttribute('data-theme');
    if (!current) {
      // No explicit override yet — read what's resolved from OS preference.
      current = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    var next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  }
</script>
</head>
<body style="margin:0;padding:0;background-color:var(--bg);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:var(--fg);">
<div style="max-width:720px;margin:0 auto;padding:24px 16px;">

  <!-- ===== Macros: shared building blocks ===== -->

  {%- macro section_header(emoji, title) %}
  <h2 style="margin:0 0 12px;padding:8px 12px;background-color:var(--header-bg);color:var(--header-fg);font-size:14px;font-weight:600;letter-spacing:0.02em;text-transform:uppercase;border-radius:4px;">
    {{ emoji }} &nbsp; {{ title }}
  </h2>
  {%- endmacro %}

  {%- macro stub_block(name) %}
  <div style="padding:12px;background-color:var(--stub-bg);border:1px dashed var(--stub-border);border-radius:4px;font-size:13px;color:var(--fg-4);font-style:italic;">
    {{ name }} section — coming soon.
  </div>
  {%- endmacro %}

  <!-- ===== Section macros: each renders ONE section's content ===== -->

  {%- macro cal_block(calendar) %}
    {{ section_header("📅", "Today's Schedule") }}
    {% if calendar.status == "ready" %}
      {% if not calendar.events %}
        <div style="padding:8px 0;color:var(--fg-3);font-size:14px;">Nothing on the calendar today.</div>
      {% else %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:14px;">
          {% for ev in calendar.events %}
          <tr>
            <td style="padding:4px 8px 4px 0;vertical-align:top;color:var(--fg-2);white-space:nowrap;">
              {%- if ev.is_error -%}<span style="color:var(--error);">error</span>{%- else -%}{{ ev.time_str }}{%- endif -%}
            </td>
            <td style="padding:4px 0;vertical-align:top;">
              {%- if ev.is_error -%}
                <span style="color:var(--error);">{{ ev.calendar }}: {{ ev.error }}</span>
              {%- elif ev.link -%}
                <a href="{{ ev.link }}" target="_blank" rel="noopener noreferrer" style="display:block;text-decoration:none;">
                  <div style="font-weight:500;color:var(--fg);">{{ ev.summary }}</div>
                  <div style="font-size:12px;color:var(--fg-4);margin-top:2px;">
                    {{ ev.calendar }}{% if ev.location %} &middot; {{ ev.location }}{% endif %}
                  </div>
                </a>
              {%- else -%}
                <div style="font-weight:500;color:var(--fg);">{{ ev.summary }}</div>
                <div style="font-size:12px;color:var(--fg-4);margin-top:2px;">
                  {{ ev.calendar }}{% if ev.location %} &middot; {{ ev.location }}{% endif %}
                </div>
              {%- endif -%}
            </td>
          </tr>
          {% endfor %}
        </table>
      {% endif %}
    {% elif calendar.status == "error" %}
      <div style="padding:8px 0;color:var(--error);font-size:13px;">Calendar fetch failed: {{ calendar.error }}</div>
    {% else %}
      {{ stub_block("Calendar") }}
    {% endif %}
  {%- endmacro %}

  {%- macro claude_block(claude_usage) %}
    {{ section_header("🤖", "Claude Usage") }}
    {% if claude_usage.status == "ready" %}
      {%- macro usage_row(label, pct, resets) %}
        <tr>
          <td style="padding:4px 8px 4px 0;vertical-align:top;color:var(--fg-2);font-size:13px;">{{ label }}</td>
          <td style="padding:4px 8px 4px 0;vertical-align:top;font-size:14px;font-weight:600;text-align:right;color:{% if pct is not none and pct >= 80 %}var(--error){% elif pct is not none and pct >= 50 %}var(--warn){% else %}var(--fg){% endif %};">
            {% if pct is not none %}{{ "%.0f"|format(pct) }}%{% else %}—{% endif %}
          </td>
        </tr>
        {% if resets %}
        <tr>
          <td colspan="2" style="padding:0 0 4px;font-size:11px;color:var(--fg-4);">resets {{ resets }}</td>
        </tr>
        {% endif %}
      {%- endmacro %}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
        {{ usage_row("5-hour session", claude_usage.session_pct, claude_usage.session_resets) }}
        {{ usage_row("7 days (all)", claude_usage.week_pct, claude_usage.week_resets) }}
        {{ usage_row("7 days (Sonnet)", claude_usage.week_sonnet_pct, claude_usage.week_sonnet_resets) }}
        {% if claude_usage.extra_enabled %}
          <tr>
            <td style="padding:4px 8px 4px 0;vertical-align:top;color:var(--fg-2);font-size:13px;">Extra usage</td>
            <td style="padding:4px 8px 4px 0;vertical-align:top;font-size:14px;font-weight:600;text-align:right;color:var(--fg);">
              {% if claude_usage.extra_pct is not none %}{{ "%.0f"|format(claude_usage.extra_pct) }}%{% else %}—{% endif %}
            </td>
          </tr>
          {% if claude_usage.extra_used_dollars is not none and claude_usage.extra_limit_dollars is not none %}
          <tr>
            <td colspan="2" style="padding:0 0 4px;font-size:11px;color:var(--fg-4);">
              ${{ "%.2f"|format(claude_usage.extra_used_dollars) }} of ${{ "%.2f"|format(claude_usage.extra_limit_dollars) }}
            </td>
          </tr>
          {% endif %}
        {% endif %}
      </table>
    {% elif claude_usage.status == "error" %}
      <div style="padding:8px 0;color:var(--error);font-size:13px;">Claude usage fetch failed: {{ claude_usage.error }}</div>
    {% else %}
      {{ stub_block("Claude Usage") }}
    {% endif %}
  {%- endmacro %}

  {%- macro email_block(email) %}
    {{ section_header("📧", "Unread / Starred Emails") }}
    {% if email.status == "ready" %}
      {% if not email.messages %}
        <div style="padding:8px 0;color:var(--fg-3);font-size:14px;">Inbox zero — nothing unread in Primary (7d) and nothing starred (30d).</div>
      {% else %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:13px;">
          {% for item in email.messages %}
          <tr>
            <td style="padding:4px 0;vertical-align:top;">
              <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" style="display:block;text-decoration:none;">
                <div style="color:var(--fg-4);font-size:12px;">
                  {{ item.sender }}{% if item.date_str %} <span style="color:var(--fg-6);">· {{ item.date_str }}</span>{% endif %}
                </div>
                <div style="color:var(--fg);">{{ item.subject }}</div>
              </a>
            </td>
          </tr>
          {% endfor %}
        </table>
      {% endif %}
    {% elif email.status == "error" %}
      <div style="padding:8px 0;color:var(--error);font-size:13px;">Email fetch failed: {{ email.error }}</div>
    {% else %}
      {{ stub_block("Email") }}
    {% endif %}
  {%- endmacro %}

  {%- macro etsy_block(etsy) %}
    {{ section_header("📦", "Etsy Orders to Ship") }}
    {% if etsy.status == "ready" %}
      {%- macro order_row(o, label_color, label_text) %}
        <tr>
          <td style="padding:4px 0;vertical-align:top;font-size:14px;color:var(--fg);">
            <div style="font-size:11px;color:{{ label_color }};text-transform:uppercase;letter-spacing:0.05em;">{{ label_text }}</div>
            <div style="font-weight:500;">#{{ o.receipt_id }} &middot; {{ o.buyer_name }} &middot; ${{ "%.2f"|format(o.total_dollars or 0) }}</div>
            <div style="font-size:12px;color:var(--fg-3);margin-top:1px;">
              {{ o.item_count }} item{% if o.item_count != 1 %}s{% endif %}
              {%- if o.titles %} — {{ o.titles | join("; ") }}{% if o.more_titles %} +{{ o.more_titles }} more{% endif %}{% endif -%}
            </div>
          </td>
        </tr>
      {%- endmacro %}
      {% if not etsy.overdue and not etsy.due_soon and not etsy.other_count %}
        <div style="padding:8px 0;color:var(--fg-3);font-size:14px;">✓ All orders shipped.</div>
      {% else %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
          {% if etsy.overdue %}
            <tr><td style="padding:8px 0 4px;font-size:12px;font-weight:600;color:var(--error);text-transform:uppercase;letter-spacing:0.05em;">Overdue ({{ etsy.overdue | length }})</td></tr>
            {% for o in etsy.overdue %}{{ order_row(o, "var(--error)", o.days_overdue ~ "d overdue") }}{% endfor %}
          {% endif %}
          {% if etsy.due_soon %}
            <tr><td style="padding:12px 0 4px;font-size:12px;font-weight:600;color:var(--warn);text-transform:uppercase;letter-spacing:0.05em;">Due soon ({{ etsy.due_soon | length }})</td></tr>
            {% for o in etsy.due_soon %}{{ order_row(o, "var(--warn)", "ship by " ~ o.ship_by_str) }}{% endfor %}
          {% endif %}
          {% if etsy.other_count %}
            <tr><td style="padding:12px 0 4px;font-size:12px;color:var(--fg-3);">
              + {{ etsy.other_count }} other outstanding (${{ "%.2f"|format(etsy.other_total_dollars) }} total)
            </td></tr>
          {% endif %}
        </table>
      {% endif %}
    {% elif etsy.status == "error" %}
      <div style="padding:8px 0;color:var(--error);font-size:13px;">Etsy fetch failed: {{ etsy.error }}</div>
    {% else %}
      {{ stub_block("Etsy Orders") }}
    {% endif %}
  {%- endmacro %}

  {%- macro news_subsection(sub) %}
    <h3 style="margin:12px 0 4px;font-size:12px;font-weight:600;color:var(--fg-2);text-transform:uppercase;letter-spacing:0.05em;">{{ sub.title }}</h3>
    {% if sub.status == "ready" %}
      {% if sub.entries %}
        <ul style="margin:0 0 4px;padding:0 0 0 18px;font-size:13px;color:var(--fg);">
          {% for item in sub.entries %}
            <li style="margin:3px 0;line-height:1.35;">
              <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="news-link">{{ item.title }}</a>
              {% if item.source %}<span style="color:var(--fg-4);font-size:11px;"> &middot; {{ item.source }}</span>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div style="font-size:12px;color:var(--fg-4);font-style:italic;">No items in last 24 hours.</div>
      {% endif %}
    {% elif sub.status == "error" %}
      <div style="font-size:12px;color:var(--error);">Feed error: {{ sub.error }}</div>
    {% else %}
      <div style="font-size:12px;color:var(--fg-4);font-style:italic;">Coming soon.</div>
    {% endif %}
  {%- endmacro %}

  {%- macro news_block(news) %}
    {{ section_header("📰", "News") }}
    {% if news.status == "ready" %}
      {%- set half = ((news.sections | length) + 1) // 2 %}
      {%- set left_subs = news.sections[:half] %}
      {%- set right_subs = news.sections[half:] %}
      <div class="cols">
        <div>
          {% for sub in left_subs %}{{ news_subsection(sub) }}{% endfor %}
        </div>
        <div>
          {% for sub in right_subs %}{{ news_subsection(sub) }}{% endfor %}
        </div>
      </div>
    {% elif news.status == "error" %}
      <div style="padding:8px 0;color:var(--error);font-size:13px;">News fetch failed: {{ news.error }}</div>
    {% else %}
      {{ stub_block("News") }}
    {% endif %}
  {%- endmacro %}

  <!-- ===== Page header (title + theme toggle) ===== -->

  <div style="border-bottom:2px solid var(--border-strong);padding-bottom:12px;margin-bottom:24px;display:flex;align-items:flex-end;justify-content:space-between;gap:12px;">
    <div>
      <h1 style="margin:0;font-size:24px;font-weight:600;letter-spacing:-0.01em;color:var(--fg);">Daily Briefing</h1>
      <div style="margin-top:4px;font-size:14px;color:var(--fg-3);">{{ date_long }}</div>
    </div>
    <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode" title="Toggle dark mode">
      <span class="icon-dark">🌙</span><span class="icon-light">☀</span>
    </button>
  </div>

  <!-- ===== Row 1: Calendar | Unread/Important Emails (the two long sections) ===== -->

  <div class="cols" style="margin-bottom:24px;">
    <div>{{ cal_block(calendar) }}</div>
    <div>{{ email_block(email) }}</div>
  </div>

  <!-- ===== Row 2: Claude Usage | Etsy Orders (the two short sections) ===== -->

  <div class="cols" style="margin-bottom:24px;">
    <div>{{ claude_block(claude_usage) }}</div>
    <div>{{ etsy_block(etsy) }}</div>
  </div>

  <!-- ===== Row 3: News (full width, internal 2-col for subsections) ===== -->

  <div style="margin-bottom:24px;">{{ news_block(news) }}</div>

  <!-- ===== Footer ===== -->

  <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);font-size:12px;color:var(--fg-5);text-align:center;">
    Generated {{ generated_at }} &middot;
    <a href="{{ archive_url }}" target="_blank" rel="noopener noreferrer" style="color:var(--fg-5);text-decoration:underline;">View archive</a>
  </div>
  <div style="margin-top:8px;font-size:11px;color:var(--fg-5);text-align:center;">
    The term "Etsy" is a trademark of Etsy, Inc. This application uses the Etsy API but is not endorsed or certified by Etsy, Inc.
  </div>

</div>
</body>
</html>
